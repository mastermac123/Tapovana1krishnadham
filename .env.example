# Copy to .env.local and fill in. Never commit the filled file — .gitignore
# already excludes .env and .env.local.

# ---------------------------------------------------------------------------
# Database — Neon (https://neon.tech). Create a project, then copy the
# *pooled* connection string. It must end with ?sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Cloudflare R2 — one private bucket. From the Cloudflare dashboard:
#   R2 > Overview                     -> account ID
#   R2 > Manage API tokens            -> Object Read & Write token
#   R2 > your bucket                  -> name
# Do NOT enable public access on the bucket. Every download is a signed URL
# minted by the app, so the bucket stays private.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="krishnadham-documents"

# ---------------------------------------------------------------------------
# Auth. Generate a secret with:  npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# The secretary account created by `npm run db:seed`. Change the password
# immediately after the first sign-in.
SEED_SECRETARY_EMAIL="secretary@krishnadham.in"
SEED_SECRETARY_PASSWORD=""
